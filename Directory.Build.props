<Project>
  <!-- Common settings for every project in the Footplate Inspection Reports solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Authors>DHARAM PAL JANGID, Senior Section Engineer (P.Way) Kota Division of WCRly</Authors>
    <Company>DHARAM PAL JANGID, Senior Section Engineer (P.Way) Kota Division of WCRly</Company>
    <Product>Footplate Inspection Reports</Product>
    <Copyright>DHARAM PAL JANGID, Senior Section Engineer (P.Way) Kota Division of WCRly</Copyright>
    <Description>Footplate (loco cab) inspection reports: entry, import from text / photo / Word / PDF / Excel, and export to PDF, Word, Excel, HTML and WhatsApp text.</Description>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
