<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FootplateIR.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Footplate Inspection Reports</ApplicationTitle>
    <ApplicationId>com.dpjangid.footplatereports</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Windows: unpackaged, self-contained .exe. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Android: signed APK (keystore passed on the command line, see build/build-android.ps1). -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F3864" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F3864" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- Reading text from photos on Android (Google ML Kit, works offline; Windows uses its own built-in OCR). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.*" />
    <!-- Align the AndroidX "ktx" packages that ML Kit brings with the newer AndroidX packages of MAUI
         (otherwise the same Java classes come twice and the APK build stops). -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.*" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.*" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.*" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootplateIR.Core\FootplateIR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="FootplateIR.Core" />
    <TrimmerRootAssembly Include="ClosedXML" />
    <TrimmerRootAssembly Include="DocumentFormat.OpenXml" />
    <TrimmerRootAssembly Include="DocumentFormat.OpenXml.Framework" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig" />
  </ItemGroup>

</Project>
